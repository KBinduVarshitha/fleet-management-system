package fleetmanagement.config;

import io.swagger.v3.oas.models.OpenAPI;
import io.swagger.v3.oas.models.info.Contact;
import io.swagger.v3.oas.models.info.Info;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

@Configuration
public class SwaggerConfig {

    @Bean
    public OpenAPI fleetManagementAPI() {

        return new OpenAPI()
                .info(new Info()
                        .title("Fleet Management and Route Optimization API")
                        .version("1.0")
                        .description("REST API for managing vehicles, drivers, routes, delivery tasks, dispatch workflow, and route optimization using OSRM.")
                        .contact(new Contact()
                                .name("Bindu Varshitha")
                                .email("your-email@example.com")));
    }
}